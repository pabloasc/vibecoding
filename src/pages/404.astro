---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="404 — Page Not Found · vibecoding.work"
  description="The page you're looking for doesn't exist. Browse developers and vibecoders on vibecoding.work."
  noindex={true}
>
  <Header />

  <main class="relative overflow-hidden">
    <div class="absolute inset-0 grid-bg pointer-events-none"></div>
    <div class="orb w-[420px] h-[420px] bg-pink -top-40 left-1/2 -translate-x-1/2 !opacity-25"></div>

    <div class="relative max-w-2xl mx-auto px-4 sm:px-6 py-24 sm:py-32 text-center">
      <p class="font-mono text-[0.8rem] text-fog">
        <span class="text-acid">$</span> cd /this-page <span class="text-pink">→ error 404</span>
      </p>

      <h1 class="font-bold tracking-[-0.04em] leading-[0.95] text-[clamp(3rem,10vw,6rem)] mt-6">
        <span class="gradient-text">404.</span><br />Nothing shipped here.
      </h1>

      <p class="text-fog text-[1.05rem] mt-6 max-w-md mx-auto">
        This profile may have been removed, or the link has a typo. Even senior devs hit dead ends — onward.
      </p>

      <div class="flex flex-wrap justify-center gap-3 mt-10">
        <a href="/#builders" class="btn-primary">Browse builders →</a>
        <a href="/submit" class="btn-ghost">Drop your profile</a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
