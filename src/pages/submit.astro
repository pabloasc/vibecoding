---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProfileCard from '../components/ProfileCard.astro';
import ProfileFields from '../components/ProfileFields.astro';

const webPage = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Drop your profile — vibecoding.work',
  url: 'https://vibecoding.work/submit',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home',              item: 'https://vibecoding.work/'       },
      { '@type': 'ListItem', position: 2, name: 'Drop your profile', item: 'https://vibecoding.work/submit' },
    ],
  },
});
---

<Layout
  title="Drop your profile — vibecoding.work"
  description="Junior developer or vibecoder? Post your profile in two minutes and get discovered by mentors, founders and teams hiring for junior jobs and freelance work."
>
  <script slot="head" type="application/ld+json" set:html={webPage} />
  <Header />

  <main class="relative">
    <div class="absolute inset-x-0 top-0 h-[420px] grid-bg pointer-events-none"></div>
    <div class="orb w-[420px] h-[420px] bg-violet -top-48 right-0 !opacity-30"></div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 md:px-8 pt-14 sm:pt-20">

      <!-- Page header -->
      <div class="max-w-2xl mb-10 fade-in">
        <span class="eyebrow">// join the launchpad</span>
        <h1 class="font-bold tracking-[-0.035em] leading-[1] text-[clamp(2.4rem,6vw,3.8rem)] mt-3">
          Drop your <span class="gradient-text">profile.</span>
        </h1>
        <p class="text-fog text-[1.08rem] leading-relaxed mt-4">
          Two minutes. No CV. Just what you've built and what you're looking for — mentors and teams take it from there.
        </p>
      </div>

      <!-- Auth checking state -->
      <div id="auth-checking" class="py-16 text-center">
        <p class="font-mono text-[0.8rem] text-fog"><span class="caret inline-block w-2 h-3.5 bg-acid align-middle mr-2"></span>Checking session…</p>
      </div>

      <!-- Auth wall -->
      <div id="auth-wall" class="hidden">
      <div class="grid lg:grid-cols-[1fr_1fr] gap-6 items-start">
        <div class="card p-6 sm:p-8">
          <div class="seg mb-6" role="tablist">
            <button id="tab-signup" class="seg-btn" role="tab" aria-selected="true">Create account</button>
            <button id="tab-signin" class="seg-btn" role="tab" aria-selected="false">Sign in</button>
          </div>

          <div id="auth-error" class="hidden banner-error mb-4">
            <p id="auth-error-msg">An error occurred.</p>
          </div>

          <div id="signup-success" class="hidden rounded-xl border border-acid/30 bg-acid/5 p-5 mb-4">
            <p class="eyebrow mb-2">Almost there</p>
            <p class="font-semibold text-[1.2rem]">Check your inbox 📬</p>
            <p class="text-fog text-[0.9rem] mt-1">Click the confirmation link to activate your account, then sign in.</p>
          </div>

          <!-- Sign up form -->
          <form id="signup-form" class="space-y-3">
            <input type="email" id="signup-email" required placeholder="you@email.com" autocomplete="email" class="field" aria-label="Email" />
            <input type="password" id="signup-password" required placeholder="Password" autocomplete="new-password" class="field" aria-label="Password" />
            <input type="password" id="signup-confirm" required placeholder="Confirm password" autocomplete="new-password" class="field" aria-label="Confirm password" />
            <button type="submit" id="signup-btn" class="btn-primary w-full !mt-5">Create account →</button>
          </form>

          <!-- Sign in form -->
          <form id="login-form" class="hidden space-y-3">
            <input type="email" id="login-email" required placeholder="you@email.com" autocomplete="email" class="field" aria-label="Email" />
            <input type="password" id="login-password" required placeholder="Password" autocomplete="current-password" class="field" aria-label="Password" />
            <button type="submit" id="login-btn" class="btn-primary w-full !mt-5">Sign in →</button>
          </form>
        </div>

        <ul class="space-y-3 lg:pt-2">
          {[
            { icon: '👀', t: 'Get seen by people who hire juniors', d: 'Mentors, founders and small teams browse new builders every week.' },
            { icon: '🧭', t: 'Find a mentor',                       d: 'Connect on LinkedIn or GitHub and get a quick intro call to show your projects.' },
            { icon: '⚡', t: 'Land your first paid assignment',     d: 'Freelance projects, internships and first roles — no 5-years-required.' },
          ].map(x => (
            <li class="flex gap-4 rounded-2xl border border-line bg-surface/60 p-5">
              <span class="text-[1.5rem] leading-none">{x.icon}</span>
              <div>
                <p class="font-semibold">{x.t}</p>
                <p class="text-fog text-[0.9rem] mt-1">{x.d}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      </div>

      <!-- Already has a profile -->
      <div id="has-profile" class="hidden card relative overflow-hidden p-8 sm:p-12 text-center max-w-2xl mx-auto">
        <div class="orb w-[300px] h-[300px] bg-violet -top-40 left-1/2 -translate-x-1/2 !opacity-30"></div>
        <p class="relative text-[3rem]">👋</p>
        <p class="relative font-bold text-[2rem] tracking-tight mt-2">You're already on the board.</p>
        <p class="relative text-fog mt-2 max-w-sm mx-auto">
          <span id="has-profile-title" class="text-snow"></span> is live. Keep it fresh — update what you've shipped and what you're after.
        </p>
        <div class="relative flex flex-wrap justify-center gap-3 mt-8">
          <a id="has-profile-edit" href="/" class="btn-primary">Edit my profile →</a>
          <a id="has-profile-view" href="/" class="btn-ghost">View it</a>
        </div>
      </div>

      <!-- Success state -->
      <div id="success-state" class="hidden card relative overflow-hidden p-8 sm:p-12 text-center max-w-2xl mx-auto">
        <div class="orb w-[300px] h-[300px] bg-acid -top-40 left-1/2 -translate-x-1/2 !opacity-25"></div>
        <p class="relative text-[3rem]">🚀</p>
        <p class="relative font-bold text-[2rem] tracking-tight mt-2">You're live!</p>
        <p class="relative text-fog mt-2 max-w-sm mx-auto">Your profile is on the board. Share it around — the more eyes, the faster that first job shows up.</p>
        <p id="success-warning" class="hidden relative banner-error mt-5 max-w-md mx-auto"></p>
        <div class="relative flex flex-wrap justify-center gap-3 mt-8">
          <a id="success-profile-link" href="/" class="btn-primary">See your profile →</a>
          <a id="success-edit-link" href="/" class="btn-ghost">Edit it anytime</a>
        </div>
      </div>

      <!-- Form (hidden until authenticated) -->
      <div id="form-wrap" class="hidden">
      <div class="grid lg:grid-cols-[minmax(0,1fr)_360px] gap-8 items-start">
        <form id="submit-form" class="space-y-5" novalidate>

          <div id="error-banner" class="hidden banner-error">
            <p id="error-message">An error occurred.</p>
          </div>

          <ProfileFields>
            <!-- Avatar -->
            <div slot="avatar" class="space-y-3">
              <span class="field-label">Avatar <span class="normal-case tracking-normal text-[#5A5A6E]">(optional)</span></span>

              <div class="seg max-w-xs" role="tablist">
                <button type="button" id="img-tab-upload" class="seg-btn" role="tab" aria-selected="true">Upload</button>
                <button type="button" id="img-tab-url" class="seg-btn" role="tab" aria-selected="false">From URL</button>
              </div>

              <div id="img-pane-upload">
                <div class="relative flex items-center gap-4 rounded-xl border border-dashed border-line hover:border-acid/60 bg-raised/50 p-4 transition-colors cursor-pointer">
                  <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp"
                    class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
                  <div class="avatar-ring w-14 h-14 shrink-0">
                    <div id="upload-thumb" class="avatar-inner text-[1.2rem]">🙂</div>
                  </div>
                  <div class="min-w-0">
                    <p id="image-name" class="font-medium text-[0.92rem] truncate">Drop a photo or click to browse</p>
                    <p class="field-hint">JPG, PNG or WebP · max 5 MB</p>
                  </div>
                  <button type="button" id="remove-image" class="hidden relative z-10 ml-auto font-mono text-[0.7rem] text-pink hover:underline">Remove</button>
                </div>
              </div>

              <div id="img-pane-url" class="hidden">
                <input type="url" id="image-url" placeholder="https://avatars.githubusercontent.com/u/…" class="field font-mono !text-[0.9rem]" aria-label="Avatar URL" />
                <p class="field-hint mt-2">Tip: your GitHub avatar works great.</p>
              </div>
            </div>
          </ProfileFields>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <button type="submit" id="submit-btn" class="btn-primary !px-7 !py-4 !text-[1rem]">Publish my profile →</button>
            <a href="/" class="text-fog hover:text-snow transition-colors text-[0.9rem]">Cancel</a>
          </div>
        </form>

        <!-- Live preview -->
        <aside class="lg:sticky lg:top-24 space-y-4">
          <p class="eyebrow">// live preview</p>
          <div id="preview" class="pointer-events-none"><ProfileCard /></div>
          <div class="rounded-2xl border border-line bg-surface/60 p-5 text-[0.88rem] text-fog leading-relaxed">
            <p class="font-semibold text-snow mb-2">💡 Profiles that get replies…</p>
            <ul class="space-y-1.5">
              <li>· link to something you actually shipped</li>
              <li>· name the tools you build with</li>
              <li>· say what you want to learn next</li>
            </ul>
          </div>
        </aside>
      </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  import { profileSlug } from '../lib/slug';
  import { ADMIN_EMAIL, profileName, type Profile } from '../lib/profile';
  import {
    readProfileFields, validateProfileFields, uploadAvatar, fillCard, fetchOwnProfile,
    initProjectEditor, readProjects, validateProjects, saveProjects,
  } from '../lib/profileForm';

  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  // ── Auth state ────────────────────────────────────────────
  const authCheckingEl = document.getElementById('auth-checking')!;
  const authWallEl     = document.getElementById('auth-wall')!;
  const formWrapEl     = document.getElementById('form-wrap')!;
  const submitFormEl   = document.getElementById('submit-form') as HTMLFormElement;
  const successEl      = document.getElementById('success-state')!;
  const hasProfileEl   = document.getElementById('has-profile')!;
  let currentToken: string = SUPABASE_ANON_KEY;

  function showAuthWall() {
    authCheckingEl.classList.add('hidden');
    authWallEl.classList.remove('hidden');
    formWrapEl.classList.add('hidden');
    hasProfileEl.classList.add('hidden');
  }

  function showForm() {
    authCheckingEl.classList.add('hidden');
    authWallEl.classList.add('hidden');
    if (successEl.classList.contains('hidden')) formWrapEl.classList.remove('hidden');
  }

  function showHasProfile(p: Profile) {
    authCheckingEl.classList.add('hidden');
    authWallEl.classList.add('hidden');
    document.getElementById('has-profile-title')!.textContent = `${profileName(p)}'s profile`;
    (document.getElementById('has-profile-edit') as HTMLAnchorElement).href = `/edit?id=${p.id}`;
    (document.getElementById('has-profile-view') as HTMLAnchorElement).href = `/profile/${profileSlug(p)}/`;
    hasProfileEl.classList.remove('hidden');
  }

  supabase.auth.onAuthStateChange((_event, session) => {
    currentToken = session?.access_token ?? SUPABASE_ANON_KEY;
    if (!session) { showAuthWall(); return; }

    // Came here only to sign in (e.g. from "Post a job") — send them back
    const next = new URLSearchParams(window.location.search).get('next');
    if (next && next.startsWith('/') && !next.startsWith('//')) { window.location.replace(next); return; }

    // One profile per builder — send returning builders to edit instead (the admin can add more)
    if (session.user.email === ADMIN_EMAIL || !successEl.classList.contains('hidden')) { showForm(); return; }
    fetchOwnProfile(session.user.id, SUPABASE_URL, SUPABASE_ANON_KEY).then(existing => {
      if (existing) showHasProfile(existing);
      else showForm();
    });
  });

  // ── Tab switching ─────────────────────────────────────────
  const tabSignin       = document.getElementById('tab-signin')!;
  const tabSignup       = document.getElementById('tab-signup')!;
  const loginFormEl     = document.getElementById('login-form') as HTMLFormElement;
  const signupFormEl    = document.getElementById('signup-form') as HTMLFormElement;
  const authErrorEl     = document.getElementById('auth-error')!;
  const authErrorMsg    = document.getElementById('auth-error-msg')!;
  const signupSuccessEl = document.getElementById('signup-success')!;

  function switchAuthTab(tab: 'signin' | 'signup') {
    tabSignin.setAttribute('aria-selected', String(tab === 'signin'));
    tabSignup.setAttribute('aria-selected', String(tab === 'signup'));
    loginFormEl.classList.toggle('hidden', tab !== 'signin');
    signupFormEl.classList.toggle('hidden', tab !== 'signup');
    authErrorEl.classList.add('hidden');
    signupSuccessEl.classList.add('hidden');
  }

  tabSignin.addEventListener('click', () => switchAuthTab('signin'));
  tabSignup.addEventListener('click', () => switchAuthTab('signup'));

  function showAuthError(msg: string) {
    authErrorMsg.textContent = msg;
    authErrorEl.classList.remove('hidden');
  }

  // ── Sign in ───────────────────────────────────────────────
  const loginBtn = document.getElementById('login-btn') as HTMLButtonElement;

  loginFormEl.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email    = (document.getElementById('login-email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('login-password') as HTMLInputElement).value;
    if (!email || !password) return;

    loginBtn.disabled = true;
    loginBtn.textContent = 'Signing in…';
    authErrorEl.classList.add('hidden');

    const { error } = await supabase.auth.signInWithPassword({ email, password });

    loginBtn.disabled = false;
    loginBtn.textContent = 'Sign in →';

    if (error) showAuthError(error.message);
    // On success, onAuthStateChange fires and calls showForm()
  });

  // ── Sign up ───────────────────────────────────────────────
  const signupBtn = document.getElementById('signup-btn') as HTMLButtonElement;

  signupFormEl.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email    = (document.getElementById('signup-email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('signup-password') as HTMLInputElement).value;
    const confirm  = (document.getElementById('signup-confirm') as HTMLInputElement).value;

    if (!email || !password) return;
    if (password !== confirm) { showAuthError('Passwords do not match.'); return; }

    signupBtn.disabled = true;
    signupBtn.textContent = 'Creating account…';
    authErrorEl.classList.add('hidden');

    const { error } = await supabase.auth.signUp({ email, password });

    signupBtn.disabled = false;
    signupBtn.textContent = 'Create account →';

    if (error) {
      showAuthError(error.message);
    } else {
      signupFormEl.classList.add('hidden');
      signupSuccessEl.classList.remove('hidden');
    }
    // If email confirmation is disabled in Supabase, onAuthStateChange fires immediately
  });

  // ── Avatar source tabs ────────────────────────────────────
  let imageSource: 'file' | 'url' = 'file';
  const imgTabUpload  = document.getElementById('img-tab-upload')!;
  const imgTabUrl     = document.getElementById('img-tab-url')!;
  const imgPaneUpload = document.getElementById('img-pane-upload')!;
  const imgPaneUrl    = document.getElementById('img-pane-url')!;

  function switchImageTab(source: 'file' | 'url') {
    imageSource = source;
    imgTabUpload.setAttribute('aria-selected', String(source === 'file'));
    imgTabUrl.setAttribute('aria-selected', String(source === 'url'));
    imgPaneUpload.classList.toggle('hidden', source !== 'file');
    imgPaneUrl.classList.toggle('hidden', source !== 'url');
    updatePreview();
  }

  imgTabUpload.addEventListener('click', () => switchImageTab('file'));
  imgTabUrl.addEventListener('click', () => switchImageTab('url'));

  // ── File upload preview ───────────────────────────────────
  const imageInput    = document.getElementById('image') as HTMLInputElement;
  const uploadThumb   = document.getElementById('upload-thumb')!;
  const imageName     = document.getElementById('image-name')!;
  const removeBtn     = document.getElementById('remove-image')!;
  const imageUrlInput = document.getElementById('image-url') as HTMLInputElement;
  let fileDataUrl: string | null = null;

  imageInput.addEventListener('change', () => {
    const file = imageInput.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (e) => {
      fileDataUrl = e.target?.result as string;
      const img = document.createElement('img');
      img.src = fileDataUrl;
      img.className = 'w-full h-full object-cover';
      uploadThumb.replaceChildren(img);
      imageName.textContent = file.name;
      removeBtn.classList.remove('hidden');
      updatePreview();
    };
    reader.readAsDataURL(file);
  });

  removeBtn.addEventListener('click', () => {
    imageInput.value = '';
    fileDataUrl = null;
    uploadThumb.textContent = '🙂';
    imageName.textContent = 'Drop a photo or click to browse';
    removeBtn.classList.add('hidden');
    updatePreview();
  });

  // ── Live preview ──────────────────────────────────────────
  const previewCard = document.querySelector<HTMLElement>('#preview .p-card')!;
  let previewDebounce: ReturnType<typeof setTimeout> | null = null;

  function updatePreview() {
    const v = readProfileFields();
    fillCard(previewCard, {
      ...v,
      id: 'preview',
      user_id: null,
      name: v.name || 'Your name',
      title: v.title || 'What you build',
      description: v.description || "What you've shipped, the tools you vibe with, and what you want to learn next.",
      link: v.link || '#',
      image_url: imageSource === 'file' ? fileDataUrl : (imageUrlInput.value.trim() || null),
      created_at: new Date().toISOString(),
    });
  }

  submitFormEl.addEventListener('input', () => {
    if (previewDebounce) clearTimeout(previewDebounce);
    previewDebounce = setTimeout(updatePreview, 120);
  });

  // "Become a mentor" links land here with ?as=mentor — preselect that option
  if (new URLSearchParams(window.location.search).get('as') === 'mentor') {
    const mentorOption = document.querySelector<HTMLInputElement>('input[name="employment_type"][value="MENTOR"]');
    if (mentorOption) mentorOption.checked = true;
  }
  updatePreview();
  initProjectEditor();

  // ── Form submission ───────────────────────────────────────
  const submitBtn    = document.getElementById('submit-btn') as HTMLButtonElement;
  const errorBanner  = document.getElementById('error-banner')!;
  const errorMessage = document.getElementById('error-message')!;

  function showError(msg: string) {
    errorMessage.textContent = msg;
    errorBanner.classList.remove('hidden');
    errorBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  submitFormEl.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBanner.classList.add('hidden');

    const values = readProfileFields();
    const projects = readProjects();
    const invalid = validateProfileFields(values) ?? validateProjects(projects);
    if (invalid) { showError(invalid); return; }

    const imageFile = imageSource === 'file' ? (imageInput.files?.[0] ?? null) : null;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Publishing…';

    try {
      let image_url: string | null = imageSource === 'url' ? (imageUrlInput.value.trim() || null) : null;
      if (imageFile) image_url = await uploadAvatar(imageFile, SUPABASE_URL, SUPABASE_ANON_KEY, currentToken);

      const insertRes = await fetch(`${SUPABASE_URL}/rest/v1/jobs`, {
        method: 'POST',
        headers: {
          apikey: SUPABASE_ANON_KEY,
          Authorization: `Bearer ${currentToken}`,
          'Content-Type': 'application/json',
          Prefer: 'return=representation',
        },
        body: JSON.stringify({ ...values, image_url }),
      });

      if (!insertRes.ok) {
        const err = await insertRes.json().catch(() => ({}));
        throw new Error(err?.message || 'Failed to save your profile.');
      }

      const [created] = await insertRes.json().catch(() => []);
      if (created?.id) {
        (document.getElementById('success-profile-link') as HTMLAnchorElement).href =
          `/profile/${profileSlug(created)}/`;
        (document.getElementById('success-edit-link') as HTMLAnchorElement).href = `/edit?id=${created.id}`;

        // The profile is already live at this point, so a project failure shouldn't send them back to the form
        try {
          await saveProjects(created.id, projects, SUPABASE_URL, SUPABASE_ANON_KEY, currentToken);
        } catch (err: unknown) {
          const warning = document.getElementById('success-warning')!;
          warning.textContent = `Your projects couldn't be saved (${err instanceof Error ? err.message : 'unknown error'}). Add them from "Edit it anytime".`;
          warning.classList.remove('hidden');
        }
      }

      formWrapEl.classList.add('hidden');
      successEl.classList.remove('hidden');
      successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });

    } catch (err: unknown) {
      showError(err instanceof Error ? err.message : 'An unexpected error occurred.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Publish my profile →';
    }
  });
</script>
