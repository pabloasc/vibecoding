---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProfileFields from '../components/ProfileFields.astro';
---

<Layout
  title="Edit Profile — vibecoding.work"
  description="Edit a builder profile."
  noindex={true}
>
  <Header />

  <main class="max-w-3xl mx-auto px-4 sm:px-6 md:px-8 pt-14">

    <!-- Page header -->
    <div class="flex items-end justify-between gap-4 mb-10">
      <div>
        <span class="eyebrow">// admin</span>
        <h1 class="font-bold tracking-[-0.03em] text-[clamp(2rem,5vw,2.8rem)] leading-none mt-2">Edit profile</h1>
      </div>
      <a id="back-link" href="/" class="text-fog hover:text-snow transition-colors text-[0.9rem]">← Back</a>
    </div>

    <!-- Auth checking -->
    <div id="auth-checking" class="py-16 text-center">
      <p class="font-mono text-[0.8rem] text-fog"><span class="caret inline-block w-2 h-3.5 bg-acid align-middle mr-2"></span>Verifying access…</p>
    </div>

    <!-- Access denied -->
    <div id="access-denied" class="hidden card py-14 text-center">
      <p class="text-[2.2rem]">🔒</p>
      <p class="font-semibold text-[1.5rem] mt-2 mb-6">Access denied.</p>
      <a href="/" class="btn-ghost">← Back to builders</a>
    </div>

    <!-- Profile not found -->
    <div id="not-found" class="hidden card py-14 text-center">
      <p class="text-[2.2rem]">🫥</p>
      <p class="font-semibold text-[1.5rem] mt-2 mb-6">Profile not found.</p>
      <a href="/" class="btn-ghost">← Back to builders</a>
    </div>

    <!-- Success state -->
    <div id="success-state" class="hidden card p-10 text-center">
      <p class="text-[2.5rem]">✅</p>
      <p class="font-bold text-[1.8rem] tracking-tight mt-2 mb-6">Profile updated.</p>
      <a id="success-back-link" href="/" class="btn-primary">View profile →</a>
    </div>

    <!-- Edit form -->
    <form id="edit-form" class="hidden space-y-5" novalidate>

      <div id="error-banner" class="hidden banner-error">
        <p id="error-message">An error occurred.</p>
      </div>

      <ProfileFields>
        <!-- Avatar -->
        <div slot="avatar" class="space-y-3">
          <span class="field-label">Avatar</span>

          <div class="flex items-center gap-4 rounded-xl border border-line bg-raised/50 p-4">
            <div class="avatar-ring w-14 h-14 shrink-0">
              <div id="current-avatar" class="avatar-inner text-[1.2rem]">🙂</div>
            </div>
            <p id="avatar-status" class="text-[0.9rem] text-fog flex-1">No image set</p>
            <button type="button" id="remove-current-image" class="hidden font-mono text-[0.7rem] text-pink hover:underline">Remove</button>
          </div>

          <div class="seg max-w-xs" role="tablist">
            <button type="button" id="img-tab-upload" class="seg-btn" role="tab" aria-selected="true">Upload new</button>
            <button type="button" id="img-tab-url" class="seg-btn" role="tab" aria-selected="false">From URL</button>
          </div>

          <div id="img-pane-upload">
            <div class="relative rounded-xl border border-dashed border-line hover:border-acid/60 bg-raised/50 p-4 transition-colors cursor-pointer">
              <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp"
                class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
              <p id="image-name" class="font-medium text-[0.92rem] truncate">Drop a photo or click to browse</p>
              <p class="field-hint">JPG, PNG or WebP · max 5 MB</p>
            </div>
          </div>

          <div id="img-pane-url" class="hidden">
            <input type="url" id="image-url" placeholder="https://avatars.githubusercontent.com/u/…" class="field font-mono !text-[0.9rem]" aria-label="Avatar URL" />
          </div>
        </div>
      </ProfileFields>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <button type="submit" id="save-btn" class="btn-primary !px-7 !py-4">Save changes →</button>
        <a id="cancel-link" href="/" class="text-fog hover:text-snow transition-colors text-[0.9rem]">Cancel</a>
      </div>

      <!-- Danger zone -->
      <div class="rounded-2xl border border-pink/25 p-5 sm:p-6 !mt-12">
        <p class="font-mono text-[0.7rem] tracking-[0.14em] uppercase text-pink mb-1">Danger zone</p>
        <p class="text-fog text-[0.9rem] mb-4">Deleting removes the profile from the board for good.</p>
        <button type="button" id="delete-btn" class="btn-danger">Delete profile</button>
      </div>

    </form>
  </main>

  <Footer />
</Layout>

<script>
  import { supabase, ADMIN_EMAIL } from '../lib/supabase';
  import { profileSlug } from '../lib/slug';
  import { initials, type Profile } from '../lib/profile';
  import { readProfileFields, validateProfileFields, fillProfileFields, uploadAvatar } from '../lib/profileForm';

  const SUPABASE_URL      = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  // ── Elements ──────────────────────────────────────────────
  const authCheckingEl = document.getElementById('auth-checking')!;
  const accessDeniedEl = document.getElementById('access-denied')!;
  const notFoundEl     = document.getElementById('not-found')!;
  const editFormEl     = document.getElementById('edit-form') as HTMLFormElement;
  const successEl      = document.getElementById('success-state')!;
  const errorBannerEl  = document.getElementById('error-banner')!;
  const errorMessageEl = document.getElementById('error-message')!;

  function showAccessDenied() {
    authCheckingEl.classList.add('hidden');
    accessDeniedEl.classList.remove('hidden');
  }

  function showNotFound() {
    authCheckingEl.classList.add('hidden');
    notFoundEl.classList.remove('hidden');
  }

  function showError(msg: string) {
    errorMessageEl.textContent = msg;
    errorBannerEl.classList.remove('hidden');
    errorBannerEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  // ── Auth & profile load ───────────────────────────────────
  let sessionToken = SUPABASE_ANON_KEY;
  let currentImageUrl: string | null = null;
  let currentTitle = '';
  let imageAction: 'keep' | 'remove' | File = 'keep';

  const profileId = new URLSearchParams(window.location.search).get('id');

  async function init() {
    if (!profileId) { showNotFound(); return; }

    // Validate JWT server-side — getUser() re-checks with Supabase auth server
    const { data: { user }, error: authError } = await supabase.auth.getUser();
    if (authError || !user || user.email !== ADMIN_EMAIL) {
      showAccessDenied();
      return;
    }

    // Store session token for authenticated API calls
    const { data: { session } } = await supabase.auth.getSession();
    sessionToken = session?.access_token ?? SUPABASE_ANON_KEY;

    const res = await fetch(
      `${SUPABASE_URL}/rest/v1/jobs?id=eq.${encodeURIComponent(profileId)}&select=*&limit=1`,
      { headers: { apikey: SUPABASE_ANON_KEY, Authorization: `Bearer ${sessionToken}` } }
    );

    if (!res.ok) { showNotFound(); return; }
    const rows: Profile[] = await res.json();
    if (!rows.length) { showNotFound(); return; }

    populateForm(rows[0]);
  }

  // ── Current avatar display ────────────────────────────────
  const currentAvatarEl = document.getElementById('current-avatar')!;
  const avatarStatusEl  = document.getElementById('avatar-status')!;
  const removeCurrentBtn = document.getElementById('remove-current-image')!;

  function renderCurrentAvatar(url: string | null, status: string) {
    if (url) {
      const img = document.createElement('img');
      img.src = url;
      img.className = 'w-full h-full object-cover';
      img.onerror = () => { currentAvatarEl.textContent = initials(currentTitle); };
      currentAvatarEl.replaceChildren(img);
    } else {
      currentAvatarEl.textContent = currentTitle ? initials(currentTitle) : '🙂';
    }
    avatarStatusEl.textContent = status;
    removeCurrentBtn.classList.toggle('hidden', !url);
  }

  function populateForm(p: Profile) {
    currentImageUrl = p.image_url;
    currentTitle = p.title;
    fillProfileFields(p);
    renderCurrentAvatar(p.image_url, p.image_url ? 'Current avatar' : 'No image set');

    const profileUrl = `/profile/${profileSlug(p.id, p.title)}/`;
    (document.getElementById('back-link') as HTMLAnchorElement).href = profileUrl;
    (document.getElementById('cancel-link') as HTMLAnchorElement).href = profileUrl;

    authCheckingEl.classList.add('hidden');
    editFormEl.classList.remove('hidden');
  }

  // ── Avatar source tabs ────────────────────────────────────
  let imageSource: 'file' | 'url' = 'file';
  const imgTabUpload  = document.getElementById('img-tab-upload')!;
  const imgTabUrl     = document.getElementById('img-tab-url')!;
  const imgPaneUpload = document.getElementById('img-pane-upload')!;
  const imgPaneUrl    = document.getElementById('img-pane-url')!;

  function switchImageTab(source: 'file' | 'url') {
    imageSource = source;
    imgTabUpload.setAttribute('aria-selected', String(source === 'file'));
    imgTabUrl.setAttribute('aria-selected', String(source === 'url'));
    imgPaneUpload.classList.toggle('hidden', source !== 'file');
    imgPaneUrl.classList.toggle('hidden', source !== 'url');
  }

  imgTabUpload.addEventListener('click', () => switchImageTab('file'));
  imgTabUrl.addEventListener('click', () => switchImageTab('url'));

  // ── Avatar handling ───────────────────────────────────────
  const imageInput    = document.getElementById('image') as HTMLInputElement;
  const imageNameEl   = document.getElementById('image-name')!;
  const imageUrlInput = document.getElementById('image-url') as HTMLInputElement;

  removeCurrentBtn.addEventListener('click', () => {
    imageAction = 'remove';
    imageInput.value = '';
    imageNameEl.textContent = 'Drop a photo or click to browse';
    renderCurrentAvatar(null, 'Avatar will be removed on save');
  });

  imageInput.addEventListener('change', () => {
    const file = imageInput.files?.[0];
    if (!file) return;
    imageAction = file;
    imageNameEl.textContent = file.name;
    const reader = new FileReader();
    reader.onload = (e) => renderCurrentAvatar(e.target?.result as string, 'New avatar — saved on submit');
    reader.readAsDataURL(file);
  });

  // ── Form save ─────────────────────────────────────────────
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;

  editFormEl.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBannerEl.classList.add('hidden');

    const values = readProfileFields();
    const invalid = validateProfileFields(values);
    if (invalid) { showError(invalid); return; }

    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving…';

    try {
      let image_url: string | null = currentImageUrl; // default: keep existing

      if (imageAction === 'remove') {
        image_url = null;
      } else if (imageSource === 'url' && imageUrlInput.value.trim()) {
        image_url = imageUrlInput.value.trim();
      } else if (imageAction instanceof File) {
        image_url = await uploadAvatar(imageAction, SUPABASE_URL, SUPABASE_ANON_KEY, sessionToken);
      }

      const patchRes = await fetch(
        `${SUPABASE_URL}/rest/v1/jobs?id=eq.${encodeURIComponent(profileId!)}`,
        {
          method: 'PATCH',
          headers: {
            apikey: SUPABASE_ANON_KEY,
            Authorization: `Bearer ${sessionToken}`,
            'Content-Type': 'application/json',
            Prefer: 'return=minimal',
          },
          body: JSON.stringify({ ...values, image_url }),
        }
      );

      if (!patchRes.ok) {
        const err = await patchRes.json().catch(() => ({}));
        throw new Error(err?.message || 'Failed to update the profile.');
      }

      (document.getElementById('success-back-link') as HTMLAnchorElement).href =
        `/profile/${profileSlug(profileId!, values.title)}/`;
      editFormEl.classList.add('hidden');
      successEl.classList.remove('hidden');
      successEl.scrollIntoView({ behavior: 'smooth' });

    } catch (err: unknown) {
      showError(err instanceof Error ? err.message : 'An unexpected error occurred.');
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save changes →';
    }
  });

  // ── Delete ────────────────────────────────────────────────
  document.getElementById('delete-btn')!.addEventListener('click', async () => {
    if (!confirm('Permanently delete this profile? This cannot be undone.')) return;

    const deleteBtn = document.getElementById('delete-btn') as HTMLButtonElement;
    deleteBtn.disabled = true;
    deleteBtn.textContent = 'Deleting…';
    errorBannerEl.classList.add('hidden');

    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/jobs?id=eq.${encodeURIComponent(profileId!)}`,
        {
          method: 'DELETE',
          headers: {
            apikey: SUPABASE_ANON_KEY,
            Authorization: `Bearer ${sessionToken}`,
          },
        }
      );

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err?.message || 'Failed to delete the profile.');
      }

      window.location.href = '/';

    } catch (err: unknown) {
      showError(err instanceof Error ? err.message : 'An unexpected error occurred.');
      deleteBtn.disabled = false;
      deleteBtn.textContent = 'Delete profile';
    }
  });

  init();
</script>
