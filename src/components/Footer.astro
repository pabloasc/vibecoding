---
const year = new Date().getFullYear();
---

<footer class="relative mt-24 border-t border-line overflow-hidden">
  <div class="orb w-[420px] h-[220px] bg-violet -bottom-32 left-1/2 -translate-x-1/2 !opacity-20"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 md:px-8 py-12 grid gap-10 sm:grid-cols-[1.4fr_1fr_1fr]">

    <!-- Brand -->
    <div>
      <a href="/" class="inline-flex items-center gap-2.5 group mb-4" aria-label="vibecoding.work home">
        <img src="/images/logo.png" alt="" class="h-7 w-auto invert opacity-80 group-hover:opacity-100 transition-opacity" />
        <span class="font-sans font-bold text-[1rem] tracking-[-0.02em]">
          vibecoding<span class="text-acid">.work</span>
        </span>
      </a>
      <p class="text-[0.9rem] text-fog leading-relaxed max-w-xs">
        The launchpad for junior developers and vibecoders. Show what you've shipped, find a mentor, land your first real gig.
      </p>
    </div>

    <!-- Builders -->
    <div class="flex flex-col gap-2.5">
      <p class="font-mono text-[0.68rem] tracking-[0.16em] uppercase text-snow/60 mb-1">Builders</p>
      <a href="/submit" class="text-[0.9rem] text-fog hover:text-acid transition-colors">Drop your profile</a>
      <a href="/#how" class="text-[0.9rem] text-fog hover:text-snow transition-colors">How it works</a>
    </div>

    <!-- Mentors -->
    <div class="flex flex-col gap-2.5">
      <p class="font-mono text-[0.68rem] tracking-[0.16em] uppercase text-snow/60 mb-1">Mentors &amp; teams</p>
      <a href="/#builders" class="text-[0.9rem] text-fog hover:text-snow transition-colors">Browse builders</a>
      <a href="/#mentors" class="text-[0.9rem] text-fog hover:text-snow transition-colors">Why mentor</a>
    </div>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 md:px-8 py-6 border-t border-line/60 flex flex-col sm:flex-row gap-2 justify-between">
    <span class="font-mono text-[0.68rem] text-[#5A5A6E]">© {year} vibecoding.work</span>
    <span class="font-mono text-[0.68rem] text-[#5A5A6E]">Built with vibes <span class="text-acid">✦</span> and a lot of tokens</span>
  </div>
</footer>
