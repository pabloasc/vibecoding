---
/**
 * Shared profile form fields for /submit and /edit.
 * Read and populate them with src/lib/profileForm.ts.
 * The avatar picker lives in each page since edit also manages the current image.
 */
import { LOOKING_FOR } from '../lib/profile';
---

<!-- ── 01 · The basics ───────────────────────────────────── -->
<fieldset class="card p-5 sm:p-7 space-y-6">
  <legend class="sr-only">The basics</legend>
  <p class="eyebrow">01 · The basics</p>

  <div class="space-y-2">
    <label for="name" class="field-label">Your name <span class="text-pink">*</span></label>
    <input type="text" id="name" name="name" required maxlength="60" autocomplete="name"
      placeholder="Maya Chen" class="field !text-[1.05rem] font-medium" />
  </div>

  <div class="space-y-2">
    <label for="title" class="field-label">Headline <span class="text-pink">*</span></label>
    <input type="text" id="title" name="title" required maxlength="80"
      placeholder="AI-native frontend builder" class="field" />
    <p class="field-hint">What you build, in a few words. Shown under your name on the board.</p>
  </div>

  <div class="space-y-2">
    <label for="description" class="field-label">About you <span class="text-pink">*</span></label>
    <textarea id="description" name="description" required rows="6"
      placeholder="What have you shipped? Which tools do you vibe with (Cursor, Claude Code, Lovable…)? What do you want to learn next?"
      class="field leading-relaxed resize-y min-h-[9rem]"></textarea>
  </div>

  <div class="space-y-2">
    <label for="link" class="field-label">Profile URL <span class="text-pink">*</span></label>
    <input type="url" id="link" name="link" required
      placeholder="https://github.com/you" class="field font-mono !text-[0.9rem]" />
    <p class="field-hint">LinkedIn or GitHub work best — that's where people in the community will connect with you.</p>
  </div>

  <slot name="avatar" />
</fieldset>

<!-- ── 02 · What you're after ────────────────────────────── -->
<fieldset class="card p-5 sm:p-7 space-y-6">
  <legend class="sr-only">What you're looking for</legend>
  <p class="eyebrow">02 · What you're after</p>

  <div class="space-y-3">
    <span class="field-label">Looking for</span>
    <div class="flex flex-wrap gap-2">
      {Object.entries(LOOKING_FOR).filter(([, o]) => !o.legacy).map(([value, { label, formLabel, emoji }], i) => (
        <label class="pill-option">
          <input type="radio" name="employment_type" value={value} checked={i === 0} />
          <span>{emoji} {formLabel ?? label}</span>
        </label>
      ))}
    </div>
  </div>

  <label class="flex items-center justify-between gap-4 rounded-xl border border-line bg-raised px-4 py-3.5 cursor-pointer">
    <span>
      <span class="block font-medium text-[0.95rem]">🌍 Open to remote work</span>
      <span class="field-hint">Most first jobs are remote — keeping this on helps.</span>
    </span>
    <input type="checkbox" id="is-remote" name="is_remote" checked class="toggle" />
  </label>

  <div class="space-y-2">
    <label for="locations" class="field-label">Based in <span class="normal-case tracking-normal text-[#5A5A6E]">(optional)</span></label>
    <input type="text" id="locations" name="locations" placeholder="Lisbon, Portugal" class="field" />
    <p class="field-hint">City and/or country. Separate several with commas.</p>
  </div>
</fieldset>

<!-- ── 03 · Projects ─────────────────────────────────────── -->
<fieldset class="card p-5 sm:p-7 space-y-5">
  <legend class="sr-only">Projects</legend>
  <div>
    <p class="eyebrow">03 · Projects</p>
    <p class="field-hint mt-2">Show what you've shipped — apps, sites, experiments. Add one or as many as you like; other builders can upvote them.</p>
  </div>

  <div id="projects-list" class="space-y-4"></div>

  <button type="button" id="add-project"
    class="w-full rounded-xl border border-dashed border-line hover:border-acid/60 hover:text-acid text-fog py-3.5 text-[0.9rem] transition-colors">
    + Add a project
  </button>
</fieldset>

<!-- One project editor — cloned by src/lib/profileForm.ts -->
<template id="tpl-project">
  <div class="project-item rounded-2xl border border-line bg-raised/40 p-4 sm:p-5 space-y-3">
    <div class="flex items-start gap-3 sm:gap-4">
      <label class="relative w-16 h-16 shrink-0 rounded-xl border border-dashed border-line hover:border-acid/60 bg-raised flex items-center justify-center cursor-pointer overflow-hidden transition-colors"
             title="Upload a logo">
        <input type="file" accept="image/jpeg,image/png,image/webp" class="project-file absolute inset-0 w-full h-full opacity-0 cursor-pointer" aria-label="Project logo" />
        <span class="project-logo pointer-events-none w-full h-full flex items-center justify-center font-mono text-[0.62rem] text-fog text-center leading-tight">+ logo</span>
      </label>
      <div class="flex-1 min-w-0 space-y-3">
        <input type="text" class="project-title field font-medium" maxlength="80" placeholder="Project name" aria-label="Project name" />
        <input type="url" class="project-link field font-mono !text-[0.85rem]" placeholder="https://myproject.app" aria-label="Project link" />
      </div>
      <button type="button" class="project-remove w-8 h-8 shrink-0 rounded-full text-fog hover:text-pink hover:bg-pink/10 transition-colors" aria-label="Remove project">✕</button>
    </div>
    <textarea class="project-description field leading-relaxed resize-y min-h-[4.5rem]" rows="2" maxlength="500"
      placeholder="What does it do? What did you build it with?" aria-label="Project description"></textarea>
  </div>
</template>
