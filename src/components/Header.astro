---
---

<header class="sticky top-0 z-50 border-b border-line/70 bg-void/75 backdrop-blur-xl">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8 h-[64px] flex items-center justify-between gap-3">

    <!-- Logo + wordmark -->
    <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label="vibecoding.work home">
      <img
        src="/images/logo.png"
        alt=""
        class="h-7 w-auto object-contain invert group-hover:rotate-[-8deg] transition-transform duration-300"
      />
      <span class="font-sans font-bold text-[1.05rem] tracking-[-0.02em] leading-none">
        vibecoding<span class="text-acid">.work</span>
      </span>
    </a>

    <!-- Nav -->
    <nav class="flex items-center gap-1 sm:gap-2">
      <a href="/jobs/" class="nav-link hidden md:block text-[0.88rem] text-fog hover:text-snow px-3 py-2 transition-colors">
        Jobs
      </a>
      <a href="/#builders" class="nav-link hidden md:block text-[0.88rem] text-fog hover:text-snow px-3 py-2 transition-colors">
        Builders
      </a>
      <a href="/#how" class="nav-link hidden lg:block text-[0.88rem] text-fog hover:text-snow px-3 py-2 transition-colors">
        How it works
      </a>
      <a href="/#community" class="nav-link hidden lg:block text-[0.88rem] text-fog hover:text-snow px-3 py-2 transition-colors">
        Community
      </a>
      <a href="/post-job" class="nav-link hidden sm:block text-[0.88rem] text-snow hover:text-acid px-3 py-2 transition-colors">
        Post a job
      </a>
      <a id="header-cta" href="/submit" class="btn-primary !py-2 !px-4 !text-[0.85rem] ml-1">
        <span id="header-cta-label"><span class="sm:hidden">Join</span><span class="hidden sm:inline">Join the community</span></span> <span aria-hidden="true">→</span>
      </a>

      <!-- Auth status -->
      <div id="auth-nav" class="hidden items-center gap-2 ml-1">
        <span id="auth-username" class="hidden sm:block font-mono text-[0.7rem] text-fog"></span>
        <button id="auth-signout"
          class="font-mono text-[0.7rem] text-fog hover:text-pink transition-colors whitespace-nowrap">
          Sign out
        </button>
      </div>
    </nav>

  </div>
</header>

<script>
  import { supabase } from '../lib/supabase';
  import { profileSlug } from '../lib/slug';
  import { fetchOwnProfile } from '../lib/profileForm';

  const authNav      = document.getElementById('auth-nav')!;
  const authUsername = document.getElementById('auth-username')!;
  const headerCta    = document.getElementById('header-cta') as HTMLAnchorElement;
  const ctaLabel     = document.getElementById('header-cta-label')!;
  const ctaDefault   = ctaLabel.innerHTML;
  const signoutBtn   = document.getElementById('auth-signout')!;

  supabase.auth.onAuthStateChange((_event, session) => {
    if (session?.user) {
      const email = session.user.email ?? '';
      authUsername.textContent = `@${email.split('@')[0]}`;
      authNav.classList.remove('hidden');
      authNav.classList.add('flex');

      // Builders who already have a profile get "My profile" instead of "Drop your profile"
      fetchOwnProfile(session.user.id, import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY)
        .then(p => {
          if (!p) return;
          headerCta.href = `/profile/${profileSlug(p)}/`;
          ctaLabel.textContent = 'My profile';
        });
    } else {
      authNav.classList.add('hidden');
      authNav.classList.remove('flex');
      headerCta.href = '/submit';
      ctaLabel.innerHTML = ctaDefault;
    }
  });

  signoutBtn.addEventListener('click', async () => {
    await supabase.auth.signOut();
    const gated = ['/submit', '/edit'];
    if (gated.some(p => window.location.pathname.startsWith(p))) {
      window.location.href = '/';
    }
  });
</script>
