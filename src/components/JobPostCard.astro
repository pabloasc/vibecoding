---
import { type JobPost, jobType, jobPostSlug, formatSalary } from '../lib/jobPost';
import { isNew, formatDate } from '../lib/profile';

export interface Props {
  job: JobPost;
  index?: number;
}

const { job, index = 0 } = Astro.props;
const type = jobType(job.employment_type);
const salary = formatSalary(job);
const locations = (job.locations ?? []).filter(Boolean);
const where = locations.length > 2 ? `${locations[0]}, ${locations[1]} +${locations.length - 2}` : locations.join(', ');
---

<article class="card card-hover fade-in group relative flex gap-4 p-5 sm:p-6" style={`animation-delay:${Math.min(index, 12) * 40}ms`}>
  <div class="w-14 h-14 shrink-0 rounded-xl border border-line bg-raised overflow-hidden flex items-center justify-center font-mono font-bold text-[1.1rem]">
    {job.image_url
      ? <img src={job.image_url} alt="" loading="lazy" width="56" height="56" class="w-full h-full object-contain p-1.5" />
      : job.name.trim()[0]?.toUpperCase()}
  </div>

  <div class="flex-1 min-w-0">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <h3 class="font-semibold text-[1.05rem] leading-snug group-hover:text-acid transition-colors">{job.title}</h3>
        <p class="text-[0.88rem] text-fog mt-0.5">{job.name}</p>
      </div>
      {isNew(job.created_at) && (
        <span class="chip chip-new shrink-0"><span class="w-1.5 h-1.5 rounded-full bg-void/70 vc-pulse"></span>New</span>
      )}
    </div>

    <div class="flex flex-wrap gap-1.5 mt-3">
      <span class="chip">{type.emoji} {type.label}</span>
      {job.is_remote === true && <span class="chip">🌍 Remote{where ? ` · ${where}` : ''}</span>}
      {job.is_remote !== true && where && <span class="chip">📍 {where}</span>}
      {salary && <span class="chip chip-acid">💰 {salary}</span>}
    </div>

    <p class="font-mono text-[0.66rem] text-[#5A5A6E] mt-3">Posted {formatDate(job.created_at)}</p>
  </div>

  <a href={`/jobs/${jobPostSlug(job)}/`} class="absolute inset-0 z-0 rounded-[1.25rem]" aria-label={`${job.title} at ${job.name}`}></a>
</article>
